// GroupNorm over rows [n, channels] (a sparse or channel-last voxel tensor's
// features), per-channel weight and bias, then SiLU when `silu`. One
// workgroup per group; mean and variance over all n rows of the group's
// channels, in two passes.
float input_[];
float weight[];
float bias[];
float output[];
struct Push @pushconstant { uint channels; uint rows; uint num_groups; float eps; uint silu; }
Push pc;
shared float red[256];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint group = input.gid.x;
    uint gi = input.lid.x;
    if (group >= pc.num_groups) return;
    uint cpg = pc.channels / pc.num_groups;
    uint c0 = group * cpg;
    uint n = cpg * pc.rows;

    float sum = 0.0;
    for (uint i = gi; i < n; i += 256u) sum += input_[(i / cpg) * pc.channels + c0 + i % cpg];
    red[gi] = sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float mean = red[0] / float(n);
    barrier;

    float var_sum = 0.0;
    for (uint i = gi; i < n; i += 256u) {
        float d = input_[(i / cpg) * pc.channels + c0 + i % cpg] - mean;
        var_sum += d * d;
    }
    red[gi] = var_sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv_std = 1.0 / sqrt(red[0] / float(n) + pc.eps);

    for (uint i = gi; i < n; i += 256u) {
        uint c = c0 + i % cpg;
        uint at = (i / cpg) * pc.channels + c;
        float y = (input_[at] - mean) * inv_std * weight[c] + bias[c];
        if (pc.silu != 0u) y = y / (1.0 + exp(-y));
        output[at] = y;
    }
}
