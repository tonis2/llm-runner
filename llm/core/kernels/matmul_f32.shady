// y[seq, out_dim] = x[seq, in_dim] @ W[row_offset .. row_offset + out_dim, :]^T, W in f32.
// 64x64 output tiles, K in steps of 32, a 4x4 patch per thread.
// Dispatch: ceil(seq/64) * ceil(out_dim/64) workgroups.
float w[];
float x[];
float y[];
struct Push @pushconstant { uint out_dim; uint in_dim; uint seq_len; uint row_offset; }
Push pc;
shared float As[2112];
shared float Bs[2112];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint gi = input.lid.x;
    uint tiles_n = (pc.out_dim + 63u) / 64u;
    uint tile_m = input.gid.x / tiles_n;
    uint tile_n = input.gid.x % tiles_n;
    uint pos_base = tile_m * 64u;
    uint row_base = pc.row_offset + tile_n * 64u;
    uint row_upper = pc.row_offset + pc.out_dim;
    uint tm = gi / 16u;
    uint tn = gi % 16u;

    float acc[16];
    for (uint i = 0u; i < 16u; i++) acc[i] = 0.0;

    uint k_tiles = (pc.in_dim + 31u) / 32u;
    for (uint t = 0u; t < k_tiles; t++) {
        uint k_base = t * 32u;
        for (uint i = 0u; i < 8u; i++) {
            uint flat = gi + i * 256u;
            uint m = flat >> 5u;
            uint k = flat & 31u;
            uint gm = pos_base + m;
            uint gk = k_base + k;
            As[m * 33u + k] = (gm < pc.seq_len && gk < pc.in_dim) ? x[gm * pc.in_dim + gk] : 0.0;
            uint gn = row_base + m;
            Bs[m * 33u + k] = (gn < row_upper && gk < pc.in_dim) ? w[gn * pc.in_dim + gk] : 0.0;
        }
        barrier;
        uint a_base = tm * 4u * 33u;
        uint b_base = tn * 4u * 33u;
        for (uint k = 0u; k < 32u; k++) {
            float a0 = As[a_base + k];
            float a1 = As[a_base + 33u + k];
            float a2 = As[a_base + 66u + k];
            float a3 = As[a_base + 99u + k];
            float b0 = Bs[b_base + k];
            float b1 = Bs[b_base + 33u + k];
            float b2 = Bs[b_base + 66u + k];
            float b3 = Bs[b_base + 99u + k];
            acc[0] += a0 * b0; acc[1] += a0 * b1; acc[2] += a0 * b2; acc[3] += a0 * b3;
            acc[4] += a1 * b0; acc[5] += a1 * b1; acc[6] += a1 * b2; acc[7] += a1 * b3;
            acc[8] += a2 * b0; acc[9] += a2 * b1; acc[10] += a2 * b2; acc[11] += a2 * b3;
            acc[12] += a3 * b0; acc[13] += a3 * b1; acc[14] += a3 * b2; acc[15] += a3 * b3;
        }
        barrier;
    }

    for (uint r = 0u; r < 4u; r++) {
        uint gm = pos_base + tm * 4u + r;
        if (gm < pc.seq_len) {
            for (uint c = 0u; c < 4u; c++) {
                uint gn = tile_n * 64u + tn * 4u + c;
                if (gn < pc.out_dim) y[gm * pc.out_dim + gn] = acc[r * 4u + c];
            }
        }
    }
}
