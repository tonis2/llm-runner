// gate = silu(gate) * up * scale — the SwiGLU tail in one pass. `scale` (1, or
// a power of two below it) keeps the hidden values a half-operand matmul reads
// next inside float16's range; the caller undoes it after that matmul.
float gate[];
float up[];
struct Push @pushconstant { uint n; float scale; }
Push pc;
struct ComputeIn { uint3 id @builtin(global_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint i = input.id.x;
    if (i >= pc.n) return;
    gate[i] = silu_of(gate[i]) * up[i] * pc.scale;
}
