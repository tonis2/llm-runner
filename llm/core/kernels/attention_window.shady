// Attention within groups of rows: block-diagonal attention over [n, heads *
// hd] buffers whose blocks are not contiguous (a sparse tensor's points
// grouped by the 3D window they fall in). `order` lists the rows group by
// group; row t attends to the keys order[span[2t]] .. order[span[2t + 1] - 1].
// One workgroup per (row, head); a group holds at most 1024 rows, hd <= 128.
// Dispatch (n, heads).
float q[];
float k[];
float v[];
uint order[];
uint span[];
float output[];
struct Push @pushconstant { uint heads; uint hd; uint n; float scale; }
Push pc;
shared float scores[1024];
shared float qv[128];
shared float red[128];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(128, 1, 1)
{
    uint t = input.gid.x;
    uint h = input.gid.y;
    uint gi = input.lid.x;
    if (t >= pc.n || h >= pc.heads) return;
    uint hd = pc.hd;
    uint width = pc.heads * hd;
    uint col = h * hd;
    uint s0 = span[2u * t];
    uint lk = span[2u * t + 1u] - s0;

    if (gi < hd) qv[gi] = q[t * width + col + gi];
    barrier;

    for (uint p = gi; p < lk; p += 128u) {
        uint kr = order[s0 + p] * width + col;
        float dot = 0.0;
        for (uint d = 0u; d < hd; d++) dot += qv[d] * k[kr + d];
        scores[p] = dot * pc.scale;
    }
    barrier;

    float mx = -1.0e30;
    for (uint p = gi; p < lk; p += 128u) mx = max(mx, scores[p]);
    red[gi] = mx;
    barrier;
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] = max(red[gi], red[gi + s]);
        barrier;
    }
    float gmax = red[0];
    barrier;

    float sum = 0.0;
    for (uint p = gi; p < lk; p += 128u) {
        float e = exp(scores[p] - gmax);
        scores[p] = e;
        sum += e;
    }
    red[gi] = sum;
    barrier;
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv = 1.0 / red[0];
    barrier;

    if (gi < hd) {
        float a = 0.0;
        for (uint p = 0u; p < lk; p++) a += scores[p] * v[order[s0 + p] * width + col + gi];
        output[t * width + col + gi] = a * inv;
    }
}
