// Attention over rows picked out of [rows, heads * hd] buffers by strides, with
// an optional additive bias: many short attentions over one token buffer, none
// of them copied out first.
//
// Sequence b's query i is row q_off + b * q_bs + i * q_is of `q` (and `output`),
// its key p row kv_off + b * kv_bs + p * kv_is of `k` and `v`; head h is columns
// h * hd .. h * hd + hd of every row. So a [frames, joints] token grid is
// attended per frame (q_bs = joints, q_is = 1) or per joint (q_bs = 1, q_is =
// joints) in place. `bias` (when has_bias) is added to the scores at
// b * bias_bs + (h * lq + i) * lk + p; a masked key is -1e30 there.
//
// One workgroup per (query, head, sequence); lk <= 1024, hd <= 128.
// Dispatch (lq, heads, sequences).
float q[];
float k[];
float v[];
float bias[];
float output[];
struct Push @pushconstant {
    uint heads; uint hd; uint lq; uint lk;
    uint q_off; uint q_bs; uint q_is;
    uint kv_off; uint kv_bs; uint kv_is;
    uint bias_bs; uint has_bias; float scale;
}
Push pc;
shared float scores[1024];
shared float qv[128];
shared float red[128];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(128, 1, 1)
{
    uint i = input.gid.x;
    uint h = input.gid.y;
    uint b = input.gid.z;
    uint gi = input.lid.x;
    if (i >= pc.lq || h >= pc.heads) return;
    uint hd = pc.hd;
    uint width = pc.heads * hd;
    uint q_row = pc.q_off + b * pc.q_bs + i * pc.q_is;
    uint col = h * hd;

    if (gi < hd) qv[gi] = q[q_row * width + col + gi];
    barrier;

    uint bias_at = b * pc.bias_bs + (h * pc.lq + i) * pc.lk;
    for (uint p = gi; p < pc.lk; p += 128u) {
        uint kr = (pc.kv_off + b * pc.kv_bs + p * pc.kv_is) * width + col;
        float dot = 0.0;
        for (uint d = 0u; d < hd; d++) dot += qv[d] * k[kr + d];
        float s = dot * pc.scale;
        if (pc.has_bias != 0u) s += bias[bias_at + p];
        scores[p] = s;
    }
    barrier;

    float mx = -1.0e30;
    for (uint p = gi; p < pc.lk; p += 128u) mx = max(mx, scores[p]);
    red[gi] = mx;
    barrier;
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] = max(red[gi], red[gi + s]);
        barrier;
    }
    float gmax = red[0];
    barrier;

    float sum = 0.0;
    for (uint p = gi; p < pc.lk; p += 128u) {
        float e = exp(scores[p] - gmax);
        scores[p] = e;
        sum += e;
    }
    red[gi] = sum;
    barrier;
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv = 1.0 / red[0];
    barrier;

    if (gi < hd) {
        float a = 0.0;
        for (uint p = 0u; p < pc.lk; p++) {
            a += scores[p] * v[(pc.kv_off + b * pc.kv_bs + p * pc.kv_is) * width + col + gi];
        }
        output[q_row * width + col + gi] = a * inv;
    }
}
