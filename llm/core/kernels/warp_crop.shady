// A crop warped out of an 8-bit image, as cv2.warpAffine (INTER_LINEAR, black
// outside) computes it for a scale-and-translate matrix: each output pixel
// blends the four source pixels around its position, in float32, rounded to
// the nearest byte (half to even). The positions are the host's (`geo`, `wts`,
// see plugins/sam3dbody/crop.js cropGeometry): every column's two source columns and
// blend, every row's two source rows and blend.
//
// Output [3, height, width] float: the byte, or with `normalize` (v / 255 -
// mean) / std per channel.
//
// Dispatch (ceil(width * height / 256), 1).
uint8 pixels[];
int geo[];
float wts[];
float output[];
struct Push @pushconstant { uint width; uint height; uint channels; uint normalize; float m0; float m1; float m2; float s0; float s1; float s2; }
Push pc;
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }

// geo: [col0 x width, col1 x width, row0 x height, row1 x height], byte
// offsets of a pixel in a row and of a row in the image, -1 off the image;
// wts: [alpha x width, beta x height].
fn float tap(int row, int col, uint c)
{
    if (row < 0 || col < 0) return 0.0;
    return float(uint(pixels[uint(row + col) + c]));
}

fn float to_byte(float v)
{
    float r = floor(v + 0.5);
    // Half to even: a tie that rounded up to an odd number goes down.
    if (r - v == 0.5 && floor(r * 0.5) * 2.0 != r) r = r - 1.0;
    return clamp(r, 0.0, 255.0);
}

fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint i = input.gid.x * 256u + input.lid.x;
    uint n = pc.width * pc.height;
    if (i >= n) return;
    uint y = i / pc.width;
    uint x = i % pc.width;
    int c0 = geo[x];
    int c1 = geo[pc.width + x];
    int r0 = geo[2u * pc.width + y];
    int r1 = geo[2u * pc.width + pc.height + y];
    float alpha = wts[x];
    float beta = wts[pc.width + y];
    for (uint c = 0u; c < 3u; c++) {
        float p00 = tap(r0, c0, c);
        float p01 = tap(r0, c1, c);
        float p10 = tap(r1, c0, c);
        float p11 = tap(r1, c1, c);
        float v0 = alpha * (p01 - p00) + p00;
        float v1 = alpha * (p11 - p10) + p10;
        float v = to_byte(beta * (v1 - v0) + v0);
        if (pc.normalize != 0u) {
            float m = c == 0u ? pc.m0 : (c == 1u ? pc.m1 : pc.m2);
            float s = c == 0u ? pc.s0 : (c == 1u ? pc.s1 : pc.s2);
            v = (v / 255.0 - m) / s;
        }
        output[c * n + i] = v;
    }
}
