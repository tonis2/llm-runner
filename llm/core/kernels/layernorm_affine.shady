// LayerNorm with weight and bias over [n_rows, dim], one workgroup per row.
float input_[];
float weight[];
float bias[];
float output[];
struct Push @pushconstant { uint dim; float eps; uint n_rows; uint pad; }
Push pc;
shared float red[256];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint row = input.gid.x;
    uint gi = input.lid.x;
    if (row >= pc.n_rows) return;
    uint base = row * pc.dim;
    float sum = 0.0;
    for (uint i = gi; i < pc.dim; i += 256u) sum += input_[base + i];
    red[gi] = sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float mean = red[0] / float(pc.dim);
    barrier;
    float var_sum = 0.0;
    for (uint i = gi; i < pc.dim; i += 256u) {
        float d = input_[base + i] - mean;
        var_sum += d * d;
    }
    red[gi] = var_sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv_std = 1.0 / sqrt(red[0] / float(pc.dim) + pc.eps);
    for (uint i = gi; i < pc.dim; i += 256u) {
        output[base + i] = (input_[base + i] - mean) * inv_std * weight[i] + bias[i];
    }
}
