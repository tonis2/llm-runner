{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": ["lib/three.c3l/lib", "dependencies"],
  "dependencies": ["llm_text", "zimage", "qwen_edit", "flux", "depth_anything", "skintokens",
                   "shady", "quickjs", "mcp", "c3w", "collision", "ktx", "font", "cui", "vk", "image", "gltf"],
  "authors": [ "John Doe <john.doe@example.com>" ],
  "version": "0.1.0",
  "sources": [
    "lib/configs/**",
    "lib/gguf/**",
    "lib/model/**",
    "lib/pipelines/**",
    "lib/shaders/**",
    "lib/vulkan/**"
  ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "script-dir": "./",
  "output": "build",
  "targets": {
    "shaders": {
			"type": "prepare",
			"exec": [
				"slangc ./lib/shaders/diffusion.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./lib/shaders/diffusion.spv",
				"slangc ./dependencies/skintokens.c3l/shaders/mesh_encoder.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/skintokens.c3l/shaders/mesh_encoder.spv",
				"slangc ./dependencies/skintokens.c3l/shaders/mesh_attention.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/skintokens.c3l/shaders/mesh_attention.spv",
				"slangc ./dependencies/llm_text.c3l/shaders/llm.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/llm_text.c3l/shaders/llm.spv",
				"slangc ./dependencies/zimage.c3l/shaders/zimage.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/zimage.c3l/shaders/zimage.spv",
				"slangc ./dependencies/zimage.c3l/shaders/mrope.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/zimage.c3l/shaders/mrope.spv",
			"slangc ./dependencies/zimage.c3l/shaders/flash_attn.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/zimage.c3l/shaders/flash_attn.spv",
				"slangc ./dependencies/qwen_edit.c3l/shaders/vit.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/qwen_edit.c3l/shaders/vit.spv",
				"slangc ./dependencies/depth_anything.c3l/shaders/depth.slang -fvk-use-entrypoint-name -target spirv -emit-spirv-directly -O2 -o ./dependencies/depth_anything.c3l/shaders/depth.spv"
			]
		},
    "zimage": {
			"type": "executable",
      "sources": ["examples/z-image/**"]
		},
    "vit-test": {
			"type": "executable",
      "sources": ["examples/vit-test/**"]
		},
    "flux": {
			"type": "executable",
      "sources": ["examples/flux/**", "server/**"]
		},
    "depth": {
			"type": "executable",
      "sources": ["examples/depth/**"]
		},
    "rig": {
			"type": "executable",
      "sources": ["examples/rig/**"]
		},
    "probe1": {
			"type": "executable",
      "sources": ["examples/probe1/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "probe2": {
			"type": "executable",
      "sources": ["examples/probe2/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "probe3": {
			"type": "executable",
      "sources": ["examples/probe3/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "probe": {
