				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "probe_bare": {
			"type": "executable",
      "sources": ["examples/probe_bare/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "q4k": {
			"type": "executable",
      "sources": ["examples/q4k/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		},
    "compute": {
			"type": "executable",
      "sources": ["examples/compute/**",
				"lib/model/**",
				"lib/gguf/**",
				"lib/three.c3l/src/app/**",
				"lib/three.c3l/src/gpu/**",
				"lib/three.c3l/src/js/**",
				"lib/three.c3l/src/mcp/**",
				"lib/three.c3l/src/render/**",
				"lib/three.c3l/src/scene/**",
				"lib/three.c3l/src/shader/**",
				"lib/three.c3l/src/advice.c3",
				"lib/three.c3l/src/paths.c3",
				"lib/three.c3l/src/reload.c3"]
		}
  },
  "cpu": "generic",
  "opt": "O2"
}