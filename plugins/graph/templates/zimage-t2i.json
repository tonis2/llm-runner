{
	"nodes": [
		{"id": "vae", "type": "core.vae", "params": {"path": "/run/media/tonis/extra/AI models/ae.safetensors"}},
		{"id": "text_encoder", "type": "core.text_encoder", "params": {"path": "/run/media/tonis/extra/AI models/Qwen3-4B-Q8_0.gguf"}},
		{"id": "prompt", "type": "zimage.text_encode", "params": {"encoder": {"from": "text_encoder.encoder"}, "prompt": "a photo of a cat"}},
		{"id": "dit", "type": "zimage.load", "params": {"path": "/run/media/tonis/extra/AI models/z-image-turbo-Q8_0.gguf"}},
		{"id": "sample", "type": "zimage.sample", "params": {"width": 1024, "height": 1024, "steps": 4, "seed": 42, "cfg": 0, "positive": {"from": "prompt.cond"}, "model": {"from": "dit.model"}}},
		{"id": "decode", "type": "core.vae_decode", "params": {"vae": {"from": "vae.vae"}, "latent": {"from": "sample.latent"}}},
		{"id": "save", "type": "core.save_image", "params": {"image": {"from": "decode.image"}, "path": "output/zimage-#.png"}}
	]
}
