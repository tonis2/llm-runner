{
	"nodes": [
		{"id": "text_encoder", "type": "core.text_encoder", "params": {"path": "/run/media/tonis/extra/AI models/Qwen3-8B-Q8_0.gguf"}},
		{"id": "prompt", "type": "flux.text_encode", "params": {"encoder": {"from": "text_encoder.encoder"}, "prompt": "turn the fox into a snow white arctic fox, keep the pose and the forest", "text_pad": 0}},
		{"id": "vae", "type": "core.vae", "params": {"path": "/run/media/tonis/extra/AI models/flux_vae.safetensors"}},
		{"id": "dit", "type": "flux.load", "params": {"path": "/run/media/tonis/extra/AI models/flux-2-klein-9b-Q8_0.gguf"}},
		{"id": "input0", "type": "core.load_image", "params": {"path": "input.png"}},
		{"id": "ref0", "type": "flux.reference", "params": {"vae": {"from": "vae.vae"}, "image": {"from": "input0.image"}, "long_side": 1024}},
		{"id": "sample", "type": "flux.sample", "params": {"cond": {"from": "prompt.cond"}, "model": {"from": "dit.model"}, "width": 1024, "height": 1024, "steps": 4, "seed": 42, "refs": {"from": "ref0.refs"}}},
		{"id": "decode", "type": "core.vae_decode", "params": {"vae": {"from": "vae.vae"}, "latent": {"from": "sample.latent"}}},
		{"id": "save", "type": "core.save_image", "params": {"image": {"from": "decode.image"}, "path": "output/kontext-#.png"}}
	]
}
