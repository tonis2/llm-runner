// GroupNorm on [C, H*W] with per-channel weight and bias, one workgroup per group.
float input_[];
float weight[];
float bias[];
float output[];
struct Push @pushconstant { uint channels; uint spatial; uint num_groups; float eps; }
Push pc;
shared float red[256];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint group = input.gid.x;
    uint gi = input.lid.x;
    if (group >= pc.num_groups) return;
    uint cpg = pc.channels / pc.num_groups;
    uint base = group * cpg * pc.spatial;
    uint n = cpg * pc.spatial;

    float sum = 0.0;
    for (uint i = gi; i < n; i += 256u) sum += input_[base + i];
    red[gi] = sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float mean = red[0] / float(n);
    barrier;

    float var_sum = 0.0;
    for (uint i = gi; i < n; i += 256u) {
        float d = input_[base + i] - mean;
        var_sum += d * d;
    }
    red[gi] = var_sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv_std = 1.0 / sqrt(red[0] / float(n) + pc.eps);

    for (uint i = gi; i < n; i += 256u) {
        uint c = group * cpg + i / pc.spatial;
        output[base + i] = (input_[base + i] - mean) * inv_std * weight[c] + bias[c];
    }
}
