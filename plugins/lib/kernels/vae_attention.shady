// Single-head self-attention for the VAE mid block, Q/K/V/out in [S, C] layout.
// One workgroup per (head, query position); keys in tiles of 4096 with an
// online softmax, so any spatial size fits. Dispatch 1D: n_heads * q_count,
// for the queries q_start .. q_start + q_count - so a long one can be cut into
// pieces, each query's answer the same whichever piece it is in.
float q[];
float k[];
float v[];
float output[];
struct Push @pushconstant { uint head_dim; uint n_heads; uint seq_len; float scale; uint channels; uint q_start; uint q_count; }
Push pc;
shared float scores[4096];
shared float red[256];
shared float qv[1024];
shared float run_max[1];
shared float run_sum[1];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint S = pc.seq_len;
    uint head = input.gid.x / pc.q_count;
    uint q_pos = pc.q_start + input.gid.x % pc.q_count;
    uint gi = input.lid.x;
    uint D = pc.head_dim;
    uint C = pc.channels;
    if (head >= pc.n_heads) return;
    uint hd0 = head * D;

    float acc[4];
    for (uint i = 0u; i < 4u; i++) acc[i] = 0.0;
    for (uint d = gi; d < D; d += 256u) qv[d] = q[q_pos * C + hd0 + d];
    if (gi == 0u) {
        run_max[0] = -1.0e30;
        run_sum[0] = 0.0;
    }
    barrier;

    uint n_tiles = (S + 4095u) / 4096u;
    for (uint t = 0u; t < n_tiles; t++) {
        uint start = t * 4096u;
        uint end = min(start + 4096u, S);
        uint len = end - start;

        for (uint i = gi; i < len; i += 256u) {
            uint p = start + i;
            float dot = 0.0;
            for (uint d = 0u; d < D; d++) dot += qv[d] * k[p * C + hd0 + d];
            scores[i] = dot * pc.scale;
        }
        barrier;

        float lm = -1.0e30;
        for (uint i = gi; i < len; i += 256u) lm = max(lm, scores[i]);
        red[gi] = lm;
        barrier;
        for (uint s = 128u; s > 0u; s >>= 1u) {
            if (gi < s) red[gi] = max(red[gi], red[gi + s]);
            barrier;
        }
        float tile_max = red[0];
        barrier;

        float old_max = run_max[0];
        float new_max = max(old_max, tile_max);
        float alpha = exp(old_max - new_max);

        float ls = 0.0;
        for (uint i = gi; i < len; i += 256u) {
            float e = exp(scores[i] - new_max);
            scores[i] = e;
            ls += e;
        }
        red[gi] = ls;
        barrier;
        for (uint s = 128u; s > 0u; s >>= 1u) {
            if (gi < s) red[gi] += red[gi + s];
            barrier;
        }
        float tile_sum = red[0];
        barrier;

        for (uint j = 0u; j < 4u; j++) {
            uint d = gi + j * 256u;
            if (d < D) {
                float a = 0.0;
                for (uint i = 0u; i < len; i++) a += scores[i] * v[(start + i) * C + hd0 + d];
                acc[j] = acc[j] * alpha + a;
            }
        }
        barrier;
        if (gi == 0u) {
            run_max[0] = new_max;
            run_sum[0] = run_sum[0] * alpha + tile_sum;
        }
        barrier;
    }

    float inv = 1.0 / run_sum[0];
    for (uint j = 0u; j < 4u; j++) {
        uint d = gi + j * 256u;
        if (d < D) output[q_pos * C + hd0 + d] = acc[j] * inv;
    }
}
