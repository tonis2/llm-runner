// x = tanh(x / 3) * 3, in place: TAESD's soft clamp on its latent input.
float data[];
struct Push @pushconstant { uint n; }
Push pc;
struct ComputeIn { uint3 id @builtin(global_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint i = input.id.x;
    if (i >= pc.n) return;
    float x = data[i] / 3.0;
    data[i] = (1.0 - 2.0 / (exp(2.0 * x) + 1.0)) * 3.0;
}
