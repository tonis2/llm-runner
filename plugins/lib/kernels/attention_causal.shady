// Causal grouped-query attention over a whole prompt, Q/K/V straight from the
// projections: q [n, n_q_heads * hd], k and v [n, n_kv_heads * hd]. One
// workgroup per (q_head, position); scores in shared memory, so n <= 1024.
// Dispatch 2D: (n_q_heads, n_tokens).
float q[];
float k[];
float v[];
float output[];
struct Push @pushconstant { uint head_dim; uint n_kv_heads; uint n_q_heads; uint n_tokens; float scale; }
Push pc;
shared float scores[1024];
shared float qv[256];
shared float red[256];
struct ComputeIn { uint3 gid @builtin(workgroup_id); uint3 lid @builtin(local_invocation_id); }
fn void main(ComputeIn input) @compute @threads(256, 1, 1)
{
    uint q_head = input.gid.x;
    uint q_pos = input.gid.y;
    uint gi = input.lid.x;
    if (q_head >= pc.n_q_heads || q_pos >= pc.n_tokens) return;
    uint hd = pc.head_dim;
    uint kv_head = q_head / (pc.n_q_heads / pc.n_kv_heads);
    uint kv_dim = pc.n_kv_heads * hd;
    uint seq = q_pos + 1u;
    uint q_base = q_pos * pc.n_q_heads * hd + q_head * hd;
    uint kv_off = kv_head * hd;

    if (gi < hd) qv[gi] = q[q_base + gi];
    barrier;

    for (uint p = gi; p < seq; p += 256u) {
        float dot = 0.0;
        for (uint d = 0u; d < hd; d++) dot += qv[d] * k[p * kv_dim + kv_off + d];
        scores[p] = dot * pc.scale;
    }
    barrier;

    float mx = -1.0e30;
    for (uint i = gi; i < seq; i += 256u) mx = max(mx, scores[i]);
    red[gi] = mx;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] = max(red[gi], red[gi + s]);
        barrier;
    }
    float gmax = red[0];
    barrier;

    float sum = 0.0;
    for (uint i = gi; i < seq; i += 256u) {
        float e = exp(scores[i] - gmax);
        scores[i] = e;
        sum += e;
    }
    red[gi] = sum;
    barrier;
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gi < s) red[gi] += red[gi + s];
        barrier;
    }
    float inv = 1.0 / red[0];
    barrier;

    for (uint d = gi; d < hd; d += 256u) {
        float a = 0.0;
        for (uint p = 0u; p < seq; p++) a += scores[p] * v[p * kv_dim + kv_off + d];
        output[q_base + d] = a * inv;
    }
}
